{
  "name": "financial-calculator-desktop",
  "productName": "Financial Calculator",
  "version": "1.0.1",
  "description": "Independent offline financial calculator for Windows",
  "author": "Cade Kendall",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "bundle": "node ../scripts/build-desktop.mjs",
    "start": "npm run bundle && electron .",
    "dist": "npm run bundle && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.cdkapps.financialcalculator",
    "productName": "Financial Calculator",
    "copyright": "MIT License. Not affiliated with Texas Instruments.",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "generated/calculator.html", "build/icon.png", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "artifactName": "FinancialCalculator-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Financial Calculator",
      "artifactName": "FinancialCalculator-Setup.${ext}"
    },
    "portable": {
      "artifactName": "FinancialCalculator-Portable.${ext}"
    }
  }
}
